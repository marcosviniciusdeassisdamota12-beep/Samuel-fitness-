{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "image": "latest",
        "simulator": false
      }
    },
    "production": {
      "android": {
        "buildType": "apk",
        "image": "latest"
      },
      "ios": {
        "image": "latest",
        "simulator": false
      }
    }
  }
}
